# Mint kernel configuration
CONFIG_MINT=y
CONFIG_MINT_SESL=y
# CONFIG_MINT_AOSP is not set

# SCSC WLAN options
CONFIG_SCSC_WLBTD=y
CONFIG_SCSC_WRITE_INFO_FILE_WLBTD=y
CONFIG_SCSC_WLAN_MAC_ADDRESS_FILENAME="/efs/wifi/.mac.info"
CONFIG_SCSC_WLAN_MAX_INTERFACES=3
CONFIG_SCSC_AP_INTERFACE_NAME="swlan0"

# Samsung MTP
CONFIG_USB_ANDROID_SAMSUNG_MTP=y

# Knox Network Context Module (NCM)
CONFIG_KNOX_NCM=y
CONFIG_DEBUG_KERNEL=y
CONFIG_KALLSYMS_ALL=y
# CONFIG_DEBUG_PREEMPT is not set
# CONFIG_SCHED_DEBUG is not set
# CONFIG_DETECT_HUNG_TASK is not set
